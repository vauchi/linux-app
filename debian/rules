#!/usr/bin/make -f
# SPDX-FileCopyrightText: 2026 Mattia Egloff <mattia.egloff@pm.me>
# SPDX-License-Identifier: GPL-3.0-or-later

export CARGO_HOME = $(CURDIR)/debian/.cargo

%:
	dh $@

# gvauchi and qvauchi conflict: both use one data directory (private#1029).
# The Qt binary builds without the GTK feature, as test:qt requires.
override_dh_auto_build:
	cargo build --release --bin gvauchi
	cargo build --release --no-default-features --features qt,camera-modules --bin qvauchi
	cargo build --release --no-default-features --features capture-pipewire --bin vauchi-camera-pipewire
	cargo build --release --no-default-features --features capture-v4l2 --bin vauchi-camera-v4l2

override_dh_auto_install:
	install -Dm 755 target/release/vauchi-camera-pipewire \
		debian/vauchi-camera-pipewire/usr/libexec/vauchi/vauchi-camera-pipewire
	install -Dm 755 target/release/vauchi-camera-v4l2 \
		debian/vauchi-camera-v4l2/usr/libexec/vauchi/vauchi-camera-v4l2
	install -Dm 755 target/release/gvauchi \
		debian/gvauchi/usr/bin/gvauchi
	install -Dm 644 data/app.vauchi.Vauchi.desktop \
		debian/gvauchi/usr/share/applications/app.vauchi.Vauchi.desktop
	install -Dm 644 data/app.vauchi.Vauchi.service \
		debian/gvauchi/usr/share/dbus-1/services/app.vauchi.Vauchi.service
	install -Dm 644 data/app.vauchi.Vauchi.metainfo.xml \
		debian/gvauchi/usr/share/metainfo/app.vauchi.Vauchi.metainfo.xml
	install -Dm 644 data/app.vauchi.Vauchi.svg \
		debian/gvauchi/usr/share/icons/hicolor/scalable/apps/app.vauchi.Vauchi.svg
	install -d debian/gvauchi/usr/share/fonts/truetype/vauchi
	install -m 644 data/fonts/*.ttf \
		debian/gvauchi/usr/share/fonts/truetype/vauchi/
	install -Dm 755 target/release/qvauchi \
		debian/qvauchi/usr/bin/qvauchi
	install -d debian/qvauchi/usr/share/applications
	sed -e 's/^Exec=gvauchi /Exec=qvauchi /' -e '/^DBusActivatable=/d' \
		-e 's/^Categories=Network;ContactManagement;GTK;$$/Categories=Network;ContactManagement;Qt;/' \
		data/app.vauchi.Vauchi.desktop \
		> debian/qvauchi/usr/share/applications/app.vauchi.Vauchi.desktop
	install -Dm 644 data/app.vauchi.Vauchi.metainfo.xml \
		debian/qvauchi/usr/share/metainfo/app.vauchi.Vauchi.metainfo.xml
	install -Dm 644 data/app.vauchi.Vauchi.svg \
		debian/qvauchi/usr/share/icons/hicolor/scalable/apps/app.vauchi.Vauchi.svg
	install -d debian/qvauchi/usr/share/fonts/truetype/vauchi
	install -m 644 data/fonts/*.ttf \
		debian/qvauchi/usr/share/fonts/truetype/vauchi/

override_dh_auto_test:
	# Tests require a running D-Bus session and display; skip in build.
	true

override_dh_auto_clean:
	cargo clean || true
	rm -rf debian/.cargo
